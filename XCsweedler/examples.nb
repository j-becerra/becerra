Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RVK", "[", "pd_PD", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "xs", ",", "x", ",", "rots", ",", 
       RowBox[{"front", "=", 
        RowBox[{"{", "0", "}"}]}], ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "@", "pd"}]}], ";", 
      RowBox[{"rots", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"2", "n"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xs", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"pd", ",", 
         RowBox[{"x_X", "\[RuleDelayed]", 
          RowBox[{"\[Piecewise]", GridBox[{
             {
              RowBox[{"Xp", "[", 
               RowBox[{
                RowBox[{
                "x", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
                "]"}], 
              RowBox[{"PositiveQ", "@", "x"}]},
             {
              RowBox[{"Xm", "[", 
               RowBox[{
                RowBox[{
                "x", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
                "]"}], "True"}
            }]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "0"}], ",", 
        RowBox[{"k", "<", 
         RowBox[{"2", "n"}]}], ",", 
        RowBox[{"++", "k"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "\[Equal]", "0"}], "\[Or]", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"front", ",", 
             RowBox[{"-", "k"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"front", "=", 
           RowBox[{"Flatten", "@", 
            RowBox[{"Replace", "[", 
             RowBox[{"front", ",", 
              RowBox[{"k", "\[Rule]", 
               RowBox[{"(", 
                RowBox[{"xs", "/.", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Xp", "[", 
                    RowBox[{
                    RowBox[{"k", "+", "1"}], ",", "l_"}], "]"}], "|", 
                    RowBox[{"Xm", "[", 
                    RowBox[{"l_", ",", 
                    RowBox[{"k", "+", "1"}]}], "]"}]}], "\[RuleDelayed]", 
                    RowBox[{"{", 
                    RowBox[{"l", ",", 
                    RowBox[{"k", "+", "1"}], ",", 
                    RowBox[{"1", "-", "l"}]}], "}"}]}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Xp", "[", 
                    RowBox[{"l_", ",", 
                    RowBox[{"k", "+", "1"}]}], "]"}], "|", 
                    RowBox[{"Xm", "[", 
                    RowBox[{
                    RowBox[{"k", "+", "1"}], ",", "l_"}], "]"}]}], 
                    "\[RuleDelayed]", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"++", 
                    RowBox[{
                    "rots", "\[LeftDoubleBracket]", "l", 
                    "\[RightDoubleBracket]"}]}], ";", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"1", "-", "l"}], ",", 
                    RowBox[{"k", "+", "1"}], ",", "l"}], "}"}]}], ")"}]}], 
                   ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"_Xp", "|", "_Xm"}], "\[RuleDelayed]", 
                    RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], 
                ")"}]}], ",", " ", 
              RowBox[{"{", "1", "}"}]}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{"front", ",", 
              RowBox[{"k", "|", 
               RowBox[{"-", "k"}]}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"-", "k"}]}], "}"}], "\[RuleDelayed]", 
             RowBox[{"--", 
              RowBox[{"rots", "\[LeftDoubleBracket]", 
               RowBox[{"k", "+", "1"}], "\[RightDoubleBracket]"}]}]}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RVK", "[", 
       RowBox[{"xs", ",", "rots"}], "]"}]}]}], " ", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RVK", "[", "K_", "]"}], ":=", 
